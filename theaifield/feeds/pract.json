---
layout: null
---
[
{% for post in site.posts %}
  {
    "field": "pract",
    "pulse": {{ post.pulse_number }},
    "date": "{{ post.date | date_to_xmlschema }}",
    "time": "{{ post.pulse_time }}",
    "title": {{ post.margin_title | jsonify }},
    "observation": {{ post.observation | strip_html | jsonify }},
    "margin": {{ post.content | strip_html | strip_newlines | jsonify }},
    "model": {{ post.model | default: "gpt-oss:120b" | jsonify }},
    "temp": {{ post.temperature | default: 0.7 }},
    "story_points": {{ post.story_points | default: 0 }},
    "story_comments": {{ post.story_comments | default: 0 }},
    "comments_fetched": {{ post.comments_fetched | default: 0 }},
    "url": "{{ post.url | absolute_url }}"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
